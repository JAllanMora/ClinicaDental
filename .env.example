# Copia este archivo a .env.local y llena los valores de tu proyecto de Supabase
# (Project Settings → API). En Vercel agrégalos en Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Sólo servidor. Se usa para invitar usuarios desde Configuración → Usuarios.
# Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# URL pública del sitio (para los enlaces de invitación y recuperación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Recordatorios (fase 5). Todo es opcional: sin credenciales los mensajes se registran en modo prueba.
# Secreto que Vercel Cron envía como "Authorization: Bearer ..." (genera uno largo y aleatorio).
CRON_SECRET=
# Twilio: WhatsApp y SMS (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_SMS_FROM=
# Plantilla aprobada de WhatsApp (Content SID "HX..."), con variables {{1}} paciente, {{2}} fecha,
# {{3}} hora, {{4}} doctor y {{5}} enlace. Requerida fuera del sandbox de Twilio.
TWILIO_WHATSAPP_CONTENT_SID=
# Resend: correo (resend.com). EMAIL_FROM debe ser de un dominio verificado.
RESEND_API_KEY=
EMAIL_FROM="Clínica Dental Villa San Juan <citas@tudominio.mx>"
